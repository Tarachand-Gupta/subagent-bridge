{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Subagent Bridge",
  "version": "0.3.0",
  "identifier": "dev.harnessbridge.desktop",
  "build": {
    "frontendDist": "../public",
    "beforeBuildCommand": "npm run stage:runtime"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Subagent Bridge",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../lib/": "backend/lib/",
      "../bin.mjs": "backend/bin.mjs",
      "../desktop-bridge.mjs": "backend/desktop-bridge.mjs",
      "../package.json": "backend/package.json",
      "../LICENSE": "backend/LICENSE",
      "../README.md": "backend/README.md",
      "../docs/install-macos.md": "backend/docs/install-macos.md",
      "../.runtime/node_modules/": "backend/node_modules/",
      "../harnesses/": "backend/harnesses/",
      "../public/rule-validation.mjs": "backend/public/rule-validation.mjs",
      "../public/rule-prompt.mjs": "backend/public/rule-prompt.mjs",
      "../public/task-library.mjs": "backend/public/task-library.mjs",
      "../docs/cli.md": "backend/docs/cli.md",
      "../examples/rules.json": "backend/examples/rules.json"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
