    "@tauri-apps/cli": "^2.12.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "acpx": "0.19.4",
    "cross-spawn": "7.0.6",
    "jsonc-parser": "3.3.1",
    "yaml": "2.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tarachand-Gupta/subagent-bridge.git"
